# ===================================================
# DATABASE CONFIGURATION (SQLite & Turso)
# ===================================================
# By default, the application runs locally with SQLite.
# Leave TURSO_DATABASE_URL empty or unset for local file:attendance.db
TURSO_DATABASE_URL=""
